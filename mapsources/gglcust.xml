
<customMultiLayerMapSource>
<name>ggl-custom</name>
<tileType>png</tileType>
<layers>
<customMapSource>
    <name>OpenStreetMap (OSM)</name>
    <tileType>png</tileType>
    <minZoom>1</minZoom>
    <maxZoom>19</maxZoom>
    <url>https://tile.openstreetmap.org/{$z}/{$x}/{$y}.png</url>
    <backgroundColor>#FFFFFF</backgroundColor> <!-- White background -->
</customMapSource>
<customMapSource>
            <name>Google Hibrido</name>
            <minZoom>0</minZoom>
            <maxZoom>19</maxZoom>
            <tileType>PNG</tileType>
            <tileUpdate>IfNoneMatch</tileUpdate>
<url>http://mt1.google.com/vt/lyrs=s,m&amp;hl=iw&amp;x={$x}&amp;y={$y}&amp;z={$z}</url>
<backgroundColor>#00000000</backgroundColor>
</customMapSource>
</layers>
</customMultiLayerMapSource>
